{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpk.io/specs/air/v1.1/interaction_patterns.schema.json",
  "title": "Interaction Patterns",
  "description": "Learned patterns about the humans and systems this agent works with.",
  "type": "object",
  "required": ["air_version", "snapshot_timestamp"],
  "properties": {
    "air_version": { "type": "string" },
    "snapshot_timestamp": { "type": "string", "format": "date-time" },
    "total_interactions": { "type": "integer", "minimum": 0 },
    "request_patterns": {
      "type": "array",
      "description": "Common request types and how the agent has learned to handle them.",
      "items": {
        "type": "object",
        "required": ["pattern_id", "description", "frequency"],
        "properties": {
          "pattern_id": { "type": "string" },
          "description": { "type": "string" },
          "frequency": { "type": "integer" },
          "typical_resolution": { "type": "string" },
          "avg_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "escalation_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "ambiguity_resolutions": {
      "type": "array",
      "description": "How the agent learned to resolve ambiguous situations in this context.",
      "items": {
        "type": "object",
        "required": ["scenario", "learned_resolution", "confidence"],
        "properties": {
          "scenario": { "type": "string" },
          "learned_resolution": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sample_count": { "type": "integer" },
          "override_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How often humans overrode this resolution."
          }
        }
      }
    },
    "communication_preferences": {
      "type": "object",
      "description": "Learned communication style preferences for this context.",
      "properties": {
        "verbosity": { "type": "string", "enum": ["minimal", "standard", "detailed"] },
        "escalation_preference": { "type": "string", "enum": ["conservative", "balanced", "aggressive"] },
        "confirmation_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "system_integrations": {
      "type": "array",
      "description": "External systems and APIs the agent learned to work with effectively.",
      "items": {
        "type": "object",
        "required": ["system_id", "interaction_count"],
        "properties": {
          "system_id": { "type": "string" },
          "system_type": { "type": "string" },
          "interaction_count": { "type": "integer" },
          "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "learned_quirks": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
